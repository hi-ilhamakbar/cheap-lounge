# ─────────────────────────────────────────────────────────────
# JASA TIKET MURAH — Airport Lounge Voucher platform
# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. No database is used: every order is delivered by email.
# ─────────────────────────────────────────────────────────────

# Public base URL of the site (used for the order link inside emails). No trailing slash.
APP_URL="http://localhost:3000"

# Secret used to encrypt order links and derive order IDs. Long random string (≥ 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates links in emails already sent.
ORDER_SECRET=""

# ── Lounge data source ───────────────────────────────────────
# "loungekey" → authorized LoungeKey / Collinson partner API (credentials required)
# "file"      → lounges listed in src/data/lounges.json, copied from an authorized LoungeKey
#                source (e.g. the LoungeKey Pass Agent Web Portal)
# If unset or misconfigured, the site shows "lounge data unavailable" — it never invents data.
LOUNGE_PROVIDER="loungekey"

# LoungeKey / Collinson partner API (issued by Collinson under a commercial agreement)
LOUNGEKEY_API_BASE_URL=""
LOUNGEKEY_API_KEY=""
LOUNGEKEY_CLIENT_ID=""
LOUNGEKEY_CLIENT_SECRET=""
# OAuth2 token URL, if the partner API uses client-credentials auth. Leave empty for API-key auth.
LOUNGEKEY_TOKEN_URL=""
# Endpoint paths — adjust to the official documentation once received.
LOUNGEKEY_AIRPORTS_PATH="/airports"
LOUNGEKEY_LOUNGES_PATH="/lounges"
LOUNGEKEY_TIMEOUT_MS="10000"

# ── Email (Resend — https://resend.com) ──────────────────────
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="JASA TIKET MURAH <noreply@yourdomain.com>"
EMAIL_REPLY_TO="jasatiketmurah@gmail.com"
# airportloungevoucher@gmail.com and jasatiketmurah@gmail.com are ALWAYS CC'd (hard-coded business rule).
# Optional extra CC recipients, comma separated:
EMAIL_EXTRA_CC=""
