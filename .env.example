# ─────────────────────────────────────────────────────────────
# JASA TIKET MURAH — Airport Lounge Voucher platform
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public base URL of the site (used in email links). No trailing slash.
APP_URL="http://localhost:3000"

# PostgreSQL (Neon / Supabase / RDS / Railway ...). Use the pooled URL for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL so migrations work through poolers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cheap_lounge?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/cheap_lounge?schema=public"

# ── Lounge data source ───────────────────────────────────────
# "loungekey" → authorized LoungeKey / Collinson partner API (credentials required)
# "database"  → lounges entered by admins in /admin/lounges, copied from an authorized
#                LoungeKey source (e.g. the LoungeKey Pass Agent Web Portal)
# If unset or misconfigured, the site shows "lounge data unavailable" — it never invents data.
LOUNGE_PROVIDER="loungekey"

# LoungeKey / Collinson partner API (issued by Collinson under a commercial agreement)
LOUNGEKEY_API_BASE_URL=""
LOUNGEKEY_API_KEY=""
LOUNGEKEY_CLIENT_ID=""
LOUNGEKEY_CLIENT_SECRET=""
# OAuth2 token URL, if the partner API uses client-credentials auth. Leave empty for API-key auth.
LOUNGEKEY_TOKEN_URL=""
# Endpoint paths — adjust to the official documentation once received.
LOUNGEKEY_AIRPORTS_PATH="/airports"
LOUNGEKEY_LOUNGES_PATH="/lounges"
LOUNGEKEY_TIMEOUT_MS="10000"

# ── Email (Resend — https://resend.com) ──────────────────────
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="JASA TIKET MURAH <noreply@yourdomain.com>"
EMAIL_REPLY_TO="jasatiketmurah@gmail.com"
# airportloungevoucher@gmail.com and jasatiketmurah@gmail.com are ALWAYS CC'd (hard-coded business rule).
# Optional extra CC recipients, comma separated:
EMAIL_EXTRA_CC=""

# ── Admin ────────────────────────────────────────────────────
# Session lifetime in hours.
ADMIN_SESSION_HOURS="12"

# ── Cron (email retry) ───────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set.
CRON_SECRET="generate-a-long-random-string"

# ── Optional QRIS gateway (dynamic QRIS + webhook) ───────────
# Not used yet: the static merchant QRIS image is shown and payments are verified manually.
# QRIS_GATEWAY_PROVIDER=""
# QRIS_GATEWAY_SERVER_KEY=""
# QRIS_GATEWAY_WEBHOOK_SECRET=""
